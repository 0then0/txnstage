root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,py,toml}]
indent_size = 4

[frontend/**.{ts,tsx,js,jsx,css,json,jsonc}]
indent_style = tab
indent_size = tab
tab_width = 2

[*.md]
# Preserve intentional Markdown hard line breaks.
trim_trailing_whitespace = false

[examples/**.json]
# These files are exported by TxnStage; do not rewrite captured artifacts.
insert_final_newline = false
