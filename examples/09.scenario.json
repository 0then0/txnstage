{
  "format_version": 1,
  "name": "FK rebuild · OFF before BEGIN",
  "description": "Disable foreign_keys on A before BEGIN and verify that B remains independently enabled. All records survive the rebuild. After COMMIT, re-enable enforcement and check the complete records and their links. This control uses local SQLite transaction boundaries unavailable in D1 migrations.",
  "settings": {
    "journal_mode": "wal",
    "busy_ms": 2000,
    "deadline_ms": 5000,
    "row_limit": 100,
    "connections": 2
  },
  "initial": [
    "CREATE TABLE parent(id INTEGER PRIMARY KEY, label TEXT NOT NULL)",
    "CREATE TABLE child(id INTEGER PRIMARY KEY, parent_id INTEGER NOT NULL REFERENCES parent(id) ON DELETE CASCADE, label TEXT NOT NULL, amount INTEGER NOT NULL, weight REAL NOT NULL, payload BLOB, memo TEXT)",
    "INSERT INTO parent VALUES(9007199254740993, 'north'), (9007199254740995, 'south')",
    "INSERT INTO child VALUES(101, 9007199254740993, 'alpha', 9223372036854775807, 1.25, X'00ff', NULL), (102, 9007199254740993, 'beta', -7, 2.5, X'', ''), (103, 9007199254740995, 'gamma', 0, -0.5, NULL, 'kept')"
  ],
  "operations": [
    {
      "id": "a_fk_on",
      "connection": "A",
      "sql": "PRAGMA foreign_keys=ON",
      "params": [],
      "after": [],
      "expect": null,
      "note": "Set enforcement explicitly on migration connection A before BEGIN."
    },
    {
      "id": "a_fk_enabled",
      "connection": "A",
      "sql": "PRAGMA foreign_keys",
      "params": [],
      "after": [
        {
          "operation": "a_fk_on",
          "event": "completed"
        }
      ],
      "expect": {
        "rows": [
          [
            {
              "type": "integer",
              "value": "1"
            }
          ]
        ]
      },
      "note": "Confirm that FK enforcement is enabled on migration connection A."
    },
    {
      "id": "a_fk_schema",
      "connection": "A",
      "sql": "PRAGMA foreign_key_list(child)",
      "params": [],
      "after": [
        {
          "operation": "a_fk_enabled",
          "event": "completed"
        }
      ],
      "expect": {
        "rows": [
          [
            {
              "type": "integer",
              "value": "0"
            },
            {
              "type": "integer",
              "value": "0"
            },
            {
              "type": "text",
              "value": "parent"
            },
            {
              "type": "text",
              "value": "parent_id"
            },
            {
              "type": "text",
              "value": "id"
            },
            {
              "type": "text",
              "value": "NO ACTION"
            },
            {
              "type": "text",
              "value": "CASCADE"
            },
            {
              "type": "text",
              "value": "NONE"
            }
          ]
        ]
      },
      "note": "Verify the actual child -> parent ON DELETE CASCADE definition."
    },
    {
      "id": "b_fk_on",
