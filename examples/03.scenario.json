{
  "format_version": 1,
  "name": "Two writers · no wait",
  "description": "SQLite allows one writer at a time. Dispatch B, wait for an observed busy callback, then commit A. This retry policy is instrumented, not sqlite3_busy_timeout. https://www.sqlite.org/c3ref/busy_handler.html",
  "settings": {
    "journal_mode": "wal",
    "busy_ms": 0,
    "deadline_ms": 5000,
    "row_limit": 100,
    "connections": 3
  },
  "initial": [
    "CREATE TABLE t (id INTEGER PRIMARY KEY, v INTEGER NOT NULL)",
    "INSERT INTO t VALUES (1, 1)"
  ],
  "operations": [
    {
      "id": "a_begin",
      "connection": "A",
      "sql": "BEGIN IMMEDIATE",
      "params": [],
      "after": [],
      "expect": null,
      "note": "A obtains write access."
    },
    {
      "id": "a_write",
      "connection": "A",
      "sql": "UPDATE t SET v = 2 WHERE id = 1",
      "params": [],
      "after": [
        {
          "operation": "a_begin",
          "event": "completed"
        }
      ],
      "expect": null,
      "note": "Keep A's transaction open."
    },
    {
      "id": "b_write",
      "connection": "B",
      "sql": "UPDATE t SET v = 3 WHERE id = 1",
      "params": [],
      "after": [
        {
          "operation": "a_write",
          "event": "completed"
        }
      ],
      "expect": {
        "extended": 5
      },
      "note": "Dispatch without waiting; B may retry."
    },
    {
      "id": "a_commit",
      "connection": "A",
      "sql": "COMMIT",
      "params": [],
      "after": [
        {
          "operation": "b_write",
          "event": "failed"
        }
      ],
      "expect": null,
      "note": "After a confirmed busy callback, release A so B can finish."
    },
    {
      "id": "b_read",
      "connection": "B",
      "sql": "SELECT v FROM t WHERE id = 1",
      "params": [],
      "after": [
        {
          "operation": "a_commit",
          "event": "completed"
        }
      ],
      "expect": {
        "rows": [
          [
            {
              "type": "integer",
              "value": "2"
            }
          ]
        ]
      },
      "note": "B's write committed."
    }
  ]
}