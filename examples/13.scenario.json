{
  "format_version": 2,
  "name": "Process crash · uncommitted transaction",
  "description": "A changes a row inside an open transaction, then its worker process is forcibly terminated between statements. A new worker opens the same database file. Queries, not journal files, establish the outcome: the original rows remain, the old transaction is gone and new writes succeed. This models the abrupt end of one process, not power loss. https://www.sqlite.org/atomiccommit.html",
  "settings": {
    "journal_mode": "wal",
    "busy_ms": 2000,
    "deadline_ms": 5000,
    "row_limit": 100,
    "connections": 2
  },
  "initial": [
    "CREATE TABLE account(id INTEGER PRIMARY KEY, balance INTEGER NOT NULL)",
    "INSERT INTO account VALUES (1, 100), (2, 50)"
  ],
  "operations": [
    {
      "id": "a_begin",
      "connection": "A",
      "sql": "BEGIN IMMEDIATE",
      "params": [],
      "after": [],
      "expect": null,
      "note": "A starts a write transaction."
    },
    {
      "id": "a_update",
      "connection": "A",
      "sql": "UPDATE account SET balance = balance - 30 WHERE id = 1",
      "params": [],
      "after": [
        {
          "operation": "a_begin",
          "event": "completed"
        }
      ],
      "expect": null,
      "note": "Change a row without committing."
    },
    {
      "id": "a_own_view",
      "connection": "A",
      "sql": "SELECT id, balance FROM account ORDER BY id",
      "params": [],
      "after": [
        {
          "operation": "a_update",
          "event": "completed"
        }
      ],
      "expect": {
        "rows": [
          [
            {
              "type": "integer",
              "value": "1"
            },
            {
              "type": "integer",
              "value": "70"
            }
          ],
          [
            {
              "type": "integer",
              "value": "2"
            },
            {
              "type": "integer",
              "value": "50"
            }
          ]
        ]
      },
      "note": "Inside its transaction A reads its own uncommitted change."
    },
    {
      "id": "a_crash",
      "connection": "A",
      "kind": "crash",
      "sql": "",
      "params": [],
      "after": [
        {
          "operation": "a_own_view",
          "event": "completed"
        }
      ],
      "expect": null,
      "note": "Forcibly terminate A's worker process after the confirmed statement. No ROLLBACK or close runs."
    },
    {
      "id": "b_while_closed",
      "connection": "B",
      "sql": "SELECT id, balance FROM account ORDER BY id",
      "params": [],
      "after": [
        {
          "operation": "a_crash",
          "event": "completed"
        }
      ],
      "expect": {
        "rows": [
          [
            {
              "type": "integer",
              "value": "1"
            },
            {
              "type": "integer",
              "value": "100"
            }
          ],
          [
            {
              "type": "integer",
              "value": "2"
            },
            {
              "type": "integer",
              "value": "50"
            }
          ]
        ]
      },
      "note": "B keeps working while A is closed and reads the original rows."
    },
    {
      "id": "a_reopen",
      "connection": "A",
      "kind": "reopen",
      "sql": "",
      "params": [],
      "after": [
        {
          "operation": "a_crash",
          "event": "completed"
        },
        {
          "operation": "b_while_closed",
          "event": "completed"
        }
      ],
      "expect": null,
      "note": "Start a new worker for A on the same database file. Initialization SQL is not rerun."
    },
    {
      "id": "a_after_reopen",
      "connection": "A",
      "sql": "SELECT id, balance FROM account ORDER BY id",
      "params": [],
      "after": [
        {
          "operation": "a_reopen",
          "event": "completed"
        }
      ],
      "expect": {
        "rows": [
          [
            {
              "type": "integer",
              "value": "1"
            },
            {
              "type": "integer",
              "value": "100"
            }
          ],
          [
            {
              "type": "integer",
              "value": "2"
            },
            {
              "type": "integer",
              "value": "50"
            }
          ]
        ]
      },
      "note": "The uncommitted change did not survive."
    },
    {
      "id": "a_commit_lost",
      "connection": "A",
      "sql": "COMMIT",
      "params": [],
      "after": [
        {
          "operation": "a_after_reopen",
          "event": "completed"
        }
      ],
      "expect": {
        "extended": 1
      },
      "note": "Expected SQLITE_ERROR (1): the new connection has no transaction to commit."
    },
    {
      "id": "a_write",
      "connection": "A",
      "sql": "UPDATE account SET balance = balance + 5 WHERE id = 2",
      "params": [],
      "after": [
        {
          "operation": "a_commit_lost",
          "event": "failed"
        }
      ],
      "expect": null,
      "note": "A new autocommit write succeeds."
    },
    {
      "id": "b_final",
      "connection": "B",
      "sql": "SELECT id, balance FROM account ORDER BY id",
      "params": [],
      "after": [
        {
          "operation": "a_write",
          "event": "completed"
        }
      ],
      "expect": {
        "rows": [
          [
            {
              "type": "integer",
              "value": "1"
            },
            {
              "type": "integer",
              "value": "100"
            }
          ],
          [
            {
              "type": "integer",
              "value": "2"
            },
            {
              "type": "integer",
              "value": "55"
            }
          ]
        ]
      },
      "note": "B reads only the write made after reopen."
    }
  ]
}